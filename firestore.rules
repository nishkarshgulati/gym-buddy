rules_version = '2';
// Access rules for Gym Buddy. Paste into Firebase console → Firestore Database → Rules → Publish.
//
// Who can do what
//   Admin (only nishkarshgulati@gmail.com, verified Google email): read everything, change roles, approve trainers.
//   Trainer (role set by the admin only): read and plan for clients linked to them; nothing once the role is removed.
//   Trainee / member: own profile, logs and notes; can see their own trainer's profile and their group's logs.
//   Everyone else: nothing. Anything not listed below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'nishkarshgulati@gmail.com';
    }
    function userData(u) { return get(/databases/$(database)/documents/users/$(u)).data; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(me())); }
    function myCircle() { return hasProfile() ? userData(me()).get('circle', '') : ''; }
    function amTrainer() { return signedIn() && hasProfile() && userData(me()).get('role', 'member') == 'trainer'; }
    function isTrainerOf(u) { return amTrainer() && userData(u).get('trainerId', '') == me(); }
    function isMyTrainer(u) { return hasProfile() && userData(me()).get('trainerId', '') == u && u != ''; }
    function sameCircle(u) { return signedIn() && myCircle() != '' && userData(u).get('circle', '') == myCircle(); }
    function isCode(c) { return c is string && c.matches('^[A-Z0-9]{6}$'); }
    function isDay(d) { return d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Profile shape: no oversized or script-like values; colour must be a plain hex colour.
    function shapeOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.get('email', '') is string && d.get('email', '').size() <= 120
        && d.get('color', '#888888') is string && d.get('color', '#888888').matches('^#[0-9A-Fa-f]{6}$')
        && d.get('role', 'member') in ['member', 'trainer']
        && d.get('signup', 'member') in ['member', 'trainer']
        && d.get('wantsTrainer', false) is bool
        && d.get('unit', 'kg') in ['kg', 'lb']
        && d.get('planNote', '') is string && d.get('planNote', '').size() <= 400
        && (d.get('trainerCode', '') == '' || isCode(d.get('trainerCode', '')))
        && (d.get('inviteCode', '') == '' || isCode(d.get('inviteCode', '')))
        && (d.get('circle', '') == '' || isCode(d.get('circle', '')))
        && d.get('schedule', {}) is map && d.get('sets', {}) is map && d.get('counts', {}) is map;
    }
    // Your own profile must carry your real Google email (no impersonating someone in lists).
    function ownEmail(d) { return d.get('email', '') == request.auth.token.email; }

    // A trainer link must come from that trainer's real code; a group must exist.
    function linksOk(d, prevTrainer, prevCircle) {
      return (d.get('trainerId', '') == '' || d.get('trainerId', '') == prevTrainer
               || (d.get('trainerCode', '') != ''
                   && get(/databases/$(database)/documents/codes/$(d.trainerCode)).data.trainerId == d.trainerId))
        && (d.get('circle', '') == '' || d.get('circle', '') == prevCircle
               || exists(/databases/$(database)/documents/circles/$(d.circle)));
    }

    match /users/{u} {
      allow get: if signedIn() && (
        u == me() || isAdmin()
        || (resource.data.get('trainerId', '') == me() && amTrainer())   // trainer → own client
        || isMyTrainer(u)                                                 // trainee → own trainer
        || (myCircle() != '' && resource.data.get('circle', '') == myCircle()));
      allow list: if signedIn() && (
        isAdmin()
        || (resource.data.trainerId == me() && amTrainer())
        || (myCircle() != '' && resource.data.circle == myCircle()));
      allow create: if signedIn() && u == me()
        && request.resource.data.get('role', '') == 'member'
        && shapeOk(request.resource.data) && ownEmail(request.resource.data)
        && linksOk(request.resource.data, '', '');
      allow update: if signedIn() && shapeOk(request.resource.data) && (
        // yourself: anything except your role
        (u == me()
          && request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
          && ownEmail(request.resource.data)
          && linksOk(request.resource.data, resource.data.get('trainerId', ''), resource.data.get('circle', '')))
        // your trainer (while still a trainer): only the plan fields
        || (resource.data.get('trainerId', '') == me() && amTrainer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule', 'sets', 'counts', 'planNote', 'updatedAt']))
        || isAdmin());
      allow delete: if isAdmin();

      match /logs/{day} {
        allow read: if signedIn() && (u == me() || isTrainerOf(u) || sameCircle(u) || isAdmin());
        allow create, update: if signedIn() && isDay(day) && (u == me() || isTrainerOf(u))
          && request.resource.data.get('ex', {}) is map && request.resource.data.get('ex', {}).size() <= 30;
        allow delete: if signedIn() && (u == me() || isAdmin());
      }
      match /meta/{doc} {
        allow read: if signedIn() && (u == me() || isTrainerOf(u) || isAdmin());
        allow create, update: if signedIn() && doc == 'notes' && (u == me() || isTrainerOf(u));
        allow delete: if signedIn() && (u == me() || isAdmin());
      }
    }

    // Trainer codes: only an approved trainer can create one, for themselves.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if amTrainer() && isCode(code)
        && request.resource.data.trainerId == me()
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 40;
      allow delete: if signedIn() && (resource.data.trainerId == me() || isAdmin());
    }

    // Family / friends groups.
    match /circles/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isCode(code)
        && request.resource.data.owner == me()
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60;
      allow delete: if isAdmin();
    }
  }
}
